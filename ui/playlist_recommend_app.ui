  <property name="styleSheet">
   <string notr="true">
QDialog#PlaylistRecommendApp { background-color: #f4f6fa; }
QWidget#plHeader { background-color: #041242; }
QLabel#plHeaderSub { color: #66BEFF; font-size: 11px; background-color: transparent; }
QLabel#plHeaderTitle { color: #ffffff; font-size: 15px; font-weight: bold; background-color: transparent; }
QWidget#plBookCard { background-color: #ffffff; border: 1px solid #d8dce8; border-radius: 8px; }
QLabel#plBookTitle { font-size: 14px; font-weight: bold; color: #111111; background-color: transparent; }
QLabel#plBookAuthor { font-size: 12px; color: #666666; background-color: transparent; }
QLabel#plGenreBadge { font-size: 11px; font-weight: bold; color: #0043FF; background-color: #deeeff; border-radius: 10px; padding: 2px 10px; }
QLabel#plSectionLabel { font-size: 12px; font-weight: bold; color: #041242; background-color: transparent; }
QLabel#plCountLabel { font-size: 11px; color: #888888; background-color: transparent; }
QWidget#plItem { background-color: #ffffff; border: 1px solid #e4e8f0; border-radius: 8px; }
QWidget#plItemAlt { background-color: #eef1f6; border: 1px solid #e4e8f0; border-radius: 8px; }
QLabel#plItemTitle { font-size: 13px; font-weight: bold; color: #111111; background-color: transparent; }
QLabel#plItemDuration { font-size: 11px; color: #888888; background-color: transparent; }
QLabel#plItemGenre { font-size: 10px; font-weight: bold; color: #EC1929; background-color: #ffe5e8; border-radius: 9px; padding: 2px 8px; }
QPushButton#plPlayBtn { background-color: #EC1929; color: #ffffff; border: none; border-radius: 14px; font-size: 12px; font-weight: bold; min-height: 28px; min-width: 60px; }
QPushButton#plPlayBtn:hover { background-color: #c41522; }
QPushButton#plCloseBtn { background-color: #ffffff; color: #555555; border: 1px solid #d0d5e0; border-radius: 6px; font-size: 13px; min-height: 36px; min-width: 80px; }
QPushButton#plCloseBtn:hover { background-color: #f0f2f6; }
QLabel#plEmptyLabel { color: #aaaaaa; font-size: 13px; background-color: transparent; }
QScrollArea { border: none; background-color: transparent; }
QScrollBar:vertical { width: 6px; background: transparent; }
QScrollBar::handle:vertical { background: #d0d5e0; border-radius: 3px; min-height: 20px; }
   </string>
